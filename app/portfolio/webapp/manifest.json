{
  "_version": "1.65.0",
  "sap.app": {
    "id": "innovation.portfolio.app",
    "type": "application",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/portfolio/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://portfolio"
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.fe.templates": {},
        "sap.f": {},
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "innovation.portfolio.app.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "PortfolioItemsList",
          "target": "PortfolioItemsList"
        },
        {
          "pattern": "PortfolioItems({key}):?query:",
          "name": "PortfolioItemsObjectPage",
          "target": "PortfolioItemsObjectPage"
        }
      ],
      "targets": {
        "PortfolioItemsList": {
          "type": "Component",
          "id": "PortfolioItemsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/PortfolioItems",
              "variantManagement": "Page",
              "navigation": {
                "PortfolioItems": {
                  "detail": {
                    "route": "PortfolioItemsObjectPage"
                  }
                }
              },
              "initialLoad": "Enabled"
            }
          }
        },
        "PortfolioItemsObjectPage": {
          "type": "Component",
          "id": "PortfolioItemsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/PortfolioItems",
              "editableHeaderContent": true
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
